def get_patient_id(filename):
    """
    Extract numeric patient ID from filename.

    Examples
    --------
    processed_486981segmented.nii
        -> 486981

    mask_processed_486981segmented.nii
        -> 486981

    processed_486981segmented.nii.gz
        -> 486981
    """

    match = re.search(r"\d+", filename)

    if match is None:
        raise ValueError(
            f"No numeric patient ID found in filename: {filename}"
        )

    return match.group(0)


