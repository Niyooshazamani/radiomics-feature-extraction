def build_file_map(files, file_type):

    file_map = {}

    for filename in files:

        patient_id = get_patient_id(filename)

        if patient_id in file_map:

            raise ValueError(
                f"\nDuplicate {file_type} ID detected: "
                f"{patient_id}\n"
                f"File 1: {file_map[patient_id]}\n"
                f"File 2: {filename}"
            )

        file_map[patient_id] = filename

    return file_map


