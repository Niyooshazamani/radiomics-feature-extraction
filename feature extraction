# ============================================================
# VALIDATE IMAGE AND MASK
# ============================================================

def validate_image_mask_pair(
    image_path,
    mask_path,
    tolerance=GEOMETRY_TOLERANCE
):
    """
    Check geometry and determine the ROI label.

    NO resampling is performed.

    Returns
    -------
    mask_label : int
        The single non-zero label in the mask.
    """

    image = sitk.ReadImage(image_path)
    mask = sitk.ReadImage(mask_path)


    # --------------------------------------------------------
    # Dimensions
    # --------------------------------------------------------

    if image.GetDimension() != mask.GetDimension():

        raise ValueError(
            "Image and mask dimensions are different. "
            f"Image={image.GetDimension()}, "
            f"Mask={mask.GetDimension()}"
        )


    # --------------------------------------------------------
    # Vector mask check
    # --------------------------------------------------------

    if mask.GetNumberOfComponentsPerPixel() != 1:

        raise ValueError(
            "Mask is a vector image. "
            "This script expects a scalar label map."
        )


    # --------------------------------------------------------
    # Size
    # --------------------------------------------------------

    if image.GetSize() != mask.GetSize():

        raise ValueError(
            "Image-mask SIZE mismatch.\n"
            f"Image size: {image.GetSize()}\n"
            f"Mask size : {mask.GetSize()}"
        )


    # --------------------------------------------------------
    # Spacing
    # --------------------------------------------------------

    if not np.allclose(
        image.GetSpacing(),
        mask.GetSpacing(),
        rtol=0,
        atol=tolerance
    ):

        raise ValueError(
            "Image-mask SPACING mismatch.\n"
            f"Image spacing: {image.GetSpacing()}\n"
            f"Mask spacing : {mask.GetSpacing()}"
        )


    # --------------------------------------------------------
    # Origin
    # --------------------------------------------------------

    if not np.allclose(
        image.GetOrigin(),
        mask.GetOrigin(),
        rtol=0,
        atol=tolerance
    ):

        raise ValueError(
            "Image-mask ORIGIN mismatch.\n"
            f"Image origin: {image.GetOrigin()}\n"
            f"Mask origin : {mask.GetOrigin()}"
        )


    # --------------------------------------------------------
    # Direction
    # --------------------------------------------------------

    if not np.allclose(
        image.GetDirection(),
        mask.GetDirection(),
        rtol=0,
        atol=tolerance
    ):

        raise ValueError(
            "Image-mask DIRECTION mismatch.\n"
            f"Image direction: {image.GetDirection()}\n"
            f"Mask direction : {mask.GetDirection()}"
        )


    # --------------------------------------------------------
    # Detect mask label
    # --------------------------------------------------------

    mask_array = sitk.GetArrayViewFromImage(mask)

    labels = np.unique(mask_array)

    # Remove background
    nonzero_labels = labels[labels != 0]


    if len(nonzero_labels) == 0:

        raise ValueError(
            "Mask is empty. No non-zero ROI was found."
        )


    if len(nonzero_labels) > 1:

        raise ValueError(
            "Mask contains multiple non-zero labels: "
            f"{nonzero_labels.tolist()}. "
            "Expected one ROI label."
        )


    mask_label = int(nonzero_labels[0])


    # --------------------------------------------------------
    # ROI voxel count
    # --------------------------------------------------------

    roi_voxels = int(
        np.count_nonzero(
            mask_array == mask_label
        )
    )


    if roi_voxels == 0:

        raise ValueError(
            f"No voxels found with label {mask_label}."
        )


    return mask_label, roi_voxels


# ============================================================
# CLEAN PYRADIOMICS RESULT
# ============================================================

def clean_result(result):

    clean = {}

    for key, value in result.items():

        # Skip PyRadiomics diagnostic information
        if key.startswith("diagnostics_"):
            continue

        # Convert numpy / SimpleITK numeric objects
        # into standard Python numeric values
        try:
            value = float(value)
        except (TypeError, ValueError):
            pass

        clean[key] = value

    return clean


# ============================================================
# SHAPE EXTRACTOR
# ============================================================
#
# Shape is independent of bin width.
# Therefore, shape is calculated only once per patient.
#
# NO RESAMPLING.
# ============================================================

shape_extractor = (
    featureextractor.RadiomicsFeatureExtractor(
        normalize=False,

        # No resampling
        resampledPixelSpacing=None,

        # Do not automatically resample/correct mask
        correctMask=False,

        geometryTolerance=GEOMETRY_TOLERANCE,

        # Diagnostics are not required in Excel
        additionalInfo=False
    )
)

shape_extractor.disableAllFeatures()

shape_extractor.enableFeatureClassByName(
    "shape"
)

shape_extractor.disableAllImageTypes()

shape_extractor.enableImageTypeByName(
    "Original"
)


# ============================================================
# CREATE EXTRACTOR FOR EACH BIN WIDTH
# ============================================================

extractors = {}


for bw in BIN_WIDTHS:

    ext = (
        featureextractor.RadiomicsFeatureExtractor(

            binWidth=bw,

            normalize=False,

            # -----------------------------------------------
            # IMPORTANT:
            # NO RESAMPLING
            # -----------------------------------------------
            resampledPixelSpacing=None,

            # Do not automatically resample mask
            correctMask=False,

            geometryTolerance=GEOMETRY_TOLERANCE,

            additionalInfo=False
        )
    )


    # --------------------------------------------------------
    # Disable all feature classes first
    # --------------------------------------------------------

    ext.disableAllFeatures()


    # --------------------------------------------------------
    # Enable requested feature classes
    # --------------------------------------------------------

    for feature_class in FEATURE_CLASSES:

        ext.enableFeatureClassByName(
            feature_class
        )


    # --------------------------------------------------------
    # Image types:
    # Original + Wavelet
    # --------------------------------------------------------

    ext.disableAllImageTypes()


    ext.enableImageTypeByName(
        "Original"
    )


    ext.enableImageTypeByName(
        "Wavelet",
        customArgs={
            "wavelet": "coif1",
            "level": 1,
            "start_level": 0
        }
    )


    extractors[bw] = ext


# ============================================================
# EXTRACTION
# ============================================================

all_rows = []

errors = []


# ------------------------------------------------------------
# Add pairing errors before extraction
# ------------------------------------------------------------

for patient_id in sorted(
    images_without_mask,
    key=int
):

    errors.append({
        "PatientID": patient_id,
        "ImageFile": image_map[patient_id],
        "MaskFile": "",
        "Error": "Mask not found"
    })


for patient_id in sorted(
    masks_without_image,
