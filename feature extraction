):

    errors.append({
        "PatientID": patient_id,
        "ImageFile": "",
        "MaskFile": mask_map[patient_id],
        "Error": "Image not found"
    })


# ------------------------------------------------------------
# Only process correctly paired patients
# ------------------------------------------------------------

patient_ids = sorted(
    matched_ids,
    key=int
)


print("\n" + "=" * 70)
print("STARTING RADIOMICS EXTRACTION")
print("=" * 70)


for i, patient_id in enumerate(
    patient_ids,
    start=1
):

    image_name = image_map[patient_id]
    mask_name = mask_map[patient_id]


    image_path = os.path.join(
        image_dir,
        image_name
    )

    mask_path = os.path.join(
        mask_dir,
        mask_name
    )


    print(
        f"\n[{i}/{len(patient_ids)}] "
        f"Patient {patient_id}"
    )

    print(
        f"  Image: {image_name}"
    )

    print(
        f"  Mask : {mask_name}"
    )


    row = {
        "PatientID": patient_id,
        "ImageFile": image_name,
        "MaskFile": mask_name
    }


    try:

        # ====================================================
        # STEP 1
        # Validate image and mask
        # ====================================================

        mask_label, roi_voxels = (
            validate_image_mask_pair(
                image_path,
                mask_path
            )
        )


        print(
            f"  Mask label: {mask_label}"
        )

        print(
            f"  ROI voxels: {roi_voxels}"
        )


        row["MaskLabel"] = mask_label
        row["ROIVoxels"] = roi_voxels


        # ====================================================
        # STEP 2
        # Shape features
        # ====================================================

        print(
            "  Extracting shape features ..."
        )


        shape_result = clean_result(

            shape_extractor.execute(
                image_path,
                mask_path,
                label=mask_label
            )
        )


        for key, value in shape_result.items():

            row[
                f"SHAPE_{key}"
            ] = value


        # ====================================================
        # STEP 3
        # BW-specific features
        # ====================================================

        for bw in BIN_WIDTHS:

            print(
                f"  Extracting BW={bw} ..."
            )


            result = clean_result(

                extractors[bw].execute(
                    image_path,
                    mask_path,
                    label=mask_label
                )
            )


            for key, value in result.items():

                row[
                    f"BW{bw}_{key}"
                ] = value


        # ====================================================
        # Successful patient
        # ====================================================

        all_rows.append(row)

        print("  Done")


        # ====================================================
        # SAVE PROGRESS
        # ====================================================

        try:

            pd.DataFrame(
                all_rows
            ).to_excel(
                output_excel,
                index=False
            )

        except Exception as save_error:

            print(
                "  WARNING: Could not save "
                "intermediate Excel file:"
            )

            print(
                f"  {save_error}"
            )


    except Exception as e:

        error_message = str(e)

        print(
            "  ERROR:",
            error_message
        )


        errors.append({

            "PatientID":
                patient_id,

            "ImageFile":
                image_name,

            "MaskFile":
                mask_name,

            "Error":
                error_message
        })


        # Save errors progressively
        try:

            pd.DataFrame(
                errors
            ).to_csv(
                error_file,
                index=False
            )

        except Exception:
            pass


# ============================================================
# FINAL SAVE
# ============================================================

df = pd.DataFrame(
    all_rows
)


df.to_excel(
    output_excel,
