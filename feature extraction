import pandas as pd
import numpy as np

# فایل استخراج‌شده
input_file = "/content/drive/MyDrive/radiomics_features_BW8_16_32.xlsx"
output_file = "/content/drive/MyDrive/radiomics_features_corr90_filtered.xlsx"

df = pd.read_excel(input_file)

# Patient ID جدا بماند
patient_id = df["PatientID"]

# فقط featureهای عددی
X = df.drop(columns=["PatientID"]).select_dtypes(include=[np.number])

print("Initial features:", X.shape[1])

# حذف featureهای ثابت
constant_cols = X.columns[X.nunique() <= 1]
X = X.drop(columns=constant_cols)

print("Constant features removed:", len(constant_cols))

# Spearman correlation
corr_matrix = X.corr(method="spearman").abs()

# فقط نیمه بالایی ماتریس
upper = corr_matrix.where(
    np.triu(np.ones(corr_matrix.shape), k=1).astype(bool)
)

# اگر correlation > 0.95 باشد، یکی از دو feature حذف می‌شود
to_drop = [

    column for column in upper.columns
    if any(upper[column] > 0.95)
]

X_filtered = X.drop(columns=to_drop)

# ذخیره خروجی
df_filtered = pd.concat(
    [patient_id.reset_index(drop=True),
     X_filtered.reset_index(drop=True)],
    axis=1
)

df_filtered.to_excel(output_file, index=False)

print("Highly correlated features removed:", len(to_drop))
print("Remaining features:", X_filtered.shape[1])
print("Saved to:", output_file)
